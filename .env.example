# All credentials stay server-side. Never commit .env.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# At least 32 random characters. Never reuse a publicly shared secret.
# Optional: trust an IP header ONLY if ingress overwrites it with one IP and
# direct origin access is blocked. Leave blank otherwise; aggregate and
# per-subject auth/mail limits still apply. Never trust client forwarding chains.
AUTH_TRUSTED_IP_HEADER=
MONGODB_URI=
FINNHUB_API_KEY=
# Use sample for a fully offline, explicitly illustrative demo.
MARKET_DATA_MODE=sample

# Account mail: Gmail compatibility, or SMTP with TLS for a production provider.
MAIL_MODE=gmail
MAIL_FROM=
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Explicitly enabled optional features; never enable before provider/legal review.
ENABLE_AI_INSIGHTS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ENABLE_BACKGROUND_EMAIL=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional weekdays at 22:00 UTC. Default is manual news briefs only.
ENABLE_DAILY_BRIEF_CRON=false

# For disposable accounts + SMTP inbox use npm.cmd run dev:test.
# It generates isolated settings itself; do not point APP_TEST_MODE at a real DB.

# Local Inngest previews run only with next dev; no real emails or AI calls.
# Set false to disable. Production always rejects these workflow invocations.
ENABLE_INNGEST_DEV=true

# Registration requires ALL operator fields plus an explicit opt-in.
ENABLE_REGISTRATION=false
LEGAL_OPERATOR_NAME=
LEGAL_COUNTRY=
LEGAL_POSTAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=

NEXT_TELEMETRY_DISABLED=1
